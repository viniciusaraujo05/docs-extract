{
    "$schema": "https://schema.railpack.com",
    "deploy": {
        "startCommand": "export MAGICK_CONFIGURE_PATH='' && identify -list policy && php artisan serve --host=0.0.0.0 --port=$PORT",
        "aptPackages": ["ghostscript"],
        "inputs": [
            {
                "type": "local",
                "source": ".railway/policy.xml",
                "destination": "/etc/ImageMagick-6/policy.xml"
            },
            {
                "type": "local",
                "source": ".railway/policy.xml",
                "destination": "/etc/ImageMagick-7/policy.xml"
            }
        ]
    }
}
