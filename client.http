###############################################################################
### 4. DOCUMENTS - Get Single Document
###############################################################################

### 4.1 Get Document by ID (Success)
GET {{baseUrl}}/documents/{{documentId}}
Authorization: Bearer {{token}}

### 4.2 Get Document - Without Token (401)
GET {{baseUrl}}/documents/{{documentId}}

### 4.3 Get Document - Not Found (404)
GET {{baseUrl}}/documents/999999
Authorization: Bearer {{token}}

### 4.4 Get Document - Access Denied (404)
# Document belongs to another user
GET {{baseUrl}}/documents/{{documentId}}
Authorization: Bearer {{token}}

###############################################################################
### 5. DOCUMENTS - List Documents
###############################################################################

### 5.1 List Documents - Default Pagination
GET {{baseUrl}}/documents
Authorization: Bearer {{token}}

### 5.2 List Documents - Custom Per Page (20 items)
GET {{baseUrl}}/documents?per_page=20
Authorization: Bearer {{token}}

### 5.3 List Documents - Max Per Page (100 items)
GET {{baseUrl}}/documents?per_page=100
Authorization: Bearer {{token}}

### 5.4 List Documents - Invalid Per Page (will use default)
GET {{baseUrl}}/documents?per_page=abc
Authorization: Bearer {{token}}

### 5.5 List Documents - Without Token (401)
GET {{baseUrl}}/documents

###############################################################################
### 6. DOCUMENTS - Search by Name
###############################################################################

### 6.1 Search by Name - Success
GET {{baseUrl}}/documents/search/name?name=invoice
Authorization: Bearer {{token}}

### 6.2 Search by Name - Partial Match
GET {{baseUrl}}/documents/search/name?name=inv
Authorization: Bearer {{token}}

### 6.3 Search by Name - Not Found (404)
GET {{baseUrl}}/documents/search/name?name=nonexistent_document
Authorization: Bearer {{token}}

### 6.4 Search by Name - Missing Parameter (422)
GET {{baseUrl}}/documents/search/name
Authorization: Bearer {{token}}

### 6.5 Search by Name - Without Token (401)
GET {{baseUrl}}/documents/search/name?name=invoice

###############################################################################
### 7. DOCUMENTS - Search by Date Range
###############################################################################

### 7.1 Search by Date - Success
POST {{baseUrl}}/documents/search/date
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "start_date": "2025-01-01",
  "end_date": "2025-01-31",
  "per_page": 20
}

### 7.2 Search by Date - Last 7 Days
POST {{baseUrl}}/documents/search/date
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "start_date": "2025-01-17",
  "end_date": "2025-01-24"
}

### 7.3 Search by Date - Custom Pagination
POST {{baseUrl}}/documents/search/date
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "start_date": "2025-01-01",
  "end_date": "2025-12-31",
  "per_page": 1
}

### 7.4 Search by Date - Missing start_date (422)
POST {{baseUrl}}/documents/search/date
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "end_date": "2025-01-31"
}

### 7.5 Search by Date - Invalid Date Range (422)
POST {{baseUrl}}/documents/search/date
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "start_date": "2025-01-31",
  "end_date": "2025-01-01"
}

### 7.6 Search by Date - Without Token (401)
POST {{baseUrl}}/documents/search/date
Content-Type: application/json

{
  "start_date": "2025-01-01",
  "end_date": "2025-01-31"
}

