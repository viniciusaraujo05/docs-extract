###############################################################################
### 1. AUTHENTICATION - Get JWT Token
###############################################################################

### 1.1 Login - Get Token (Success)
POST {{baseUrl}}/authforce
Content-Type: application/json

{
  "client_id": "{{clientId}}",
  "client_secret": "{{clientSecret}}"
}

### 1.2 Login - Invalid Credentials (401)
POST {{baseUrl}}/auth/token
Content-Type: application/json

{
  "client_id": "invalid_client",
  "client_secret": "wrong_secret"
}

### 1.3 Login - Missing Fields (422)
POST {{baseUrl}}/auth/token
Content-Type: application/json

{
  "client_id": "{{clientId}}"
}

###############################################################################
### 2. TOKEN MANAGEMENT
###############################################################################

### 2.1 Refresh Token
POST {{baseUrl}}/auth/refresh
Authorization: Bearer {{token}}

### 2.2 Logout (Invalidate Token)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### 2.3 Refresh - Without Token (401)
POST {{baseUrl}}/auth/refresh

###############################################################################
### 3. DOCUMENTS - Upload
###############################################################################

### 3.1 Upload Invoice PDF (Success)
POST {{baseUrl}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="invoice.pdf"
Content-Type: application/pdf

< ./tests/fixtures/sample_invoice.pdf
--boundary
Content-Disposition: form-data; name="type"

invoice
--boundary--

### 3.2 Upload Receipt Image (Success)
POST {{baseUrl}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="receipt.jpg"
Content-Type: image/jpeg

< ./tests/fixtures/sample_receipt.jpg
--boundary
Content-Disposition: form-data; name="type"

receipt
--boundary--

### 3.3 Upload Custom Document with Schema
POST {{baseUrl}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="custom.pdf"
Content-Type: application/pdf

< ./tests/fixtures/sample_custom.pdf
--boundary
Content-Disposition: form-data; name="type"

custom
--boundary
Content-Disposition: form-data; name="schema"

{"fields": [{"name": "company_name", "type": "text"}, {"name": "amount", "type": "number"}]}
--boundary--

### 3.4 Upload - Without Token (401)
POST {{baseUrl}}/documents
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="invoice.pdf"
Content-Type: application/pdf

< ./tests/fixtures/sample_invoice.pdf
--boundary
Content-Disposition: form-data; name="type"

invoice
--boundary--

### 3.5 Upload - Invalid File Type (422)
POST {{baseUrl}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="document.txt"
Content-Type: text/plain

Sample text content
--boundary
Content-Disposition: form-data; name="type"

invoice
--boundary--

### 3.6 Upload - Missing File (422)
POST {{baseUrl}}/documents
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "invoice"
}

### 3.7 Upload - Invalid Type (422)
POST {{baseUrl}}/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="invoice.pdf"
Content-Type: application/pdf

< ./tests/fixtures/sample_invoice.pdf
--boundary
