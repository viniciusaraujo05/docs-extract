# Run this multiple times quickly to trigger 429
GET {{baseUrl}}/documents
Authorization: Bearer {{token}}

###############################################################################
### 7. COMPLETE WORKFLOW TEST
###############################################################################

### 7.1 Step 1: Login
# @name login
POST {{baseUrl}}/auth/token
Content-Type: application/json

{
  "client_id": "{{clientId}}",
  "client_secret": "{{clientSecret}}"
}

### 7.2 Step 2: Upload Document
# Use token from previous request
POST {{baseUrl}}/documents
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="invoice.pdf"
Content-Type: application/pdf

< ./tests/fixtures/sample_invoice.pdf
--boundary
Content-Disposition: form-data; name="type"

invoice
--boundary--

### 7.3 Step 3: Check Document Status
# @name upload
GET {{baseUrl}}/documents/{{upload.response.body.data.id}}
Authorization: Bearer {{login.response.body.access_token}}

### 7.4 Step 4: List All Documents
GET {{baseUrl}}/documents?per_page=50
Authorization: Bearer {{login.response.body.access_token}}

### 7.5 Step 5: Refresh Token
POST {{baseUrl}}/auth/refresh
Authorization: Bearer {{login.response.body.access_token}}

### 7.6 Step 6: Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{login.response.body.access_token}}

###############################################################################
### 8. ERROR SCENARIOS
###############################################################################

### 8.1 Expired Token (401)
POST {{baseUrl}}/documents
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.expired_token

### 8.2 Malformed Token (401)
GET {{baseUrl}}/documents
Authorization: Bearer invalid_token_format

### 8.3 Missing Authorization Header (401)
GET {{baseUrl}}/documents

### 8.4 Wrong Token Type (401)
GET {{baseUrl}}/documents
Authorization: Basic {{token}}

###############################################################################
### NOTES
###############################################################################

# 1. Replace {{token}} with actual JWT token from login response
# 2. Replace {{documentId}} with actual document ID from upload response
# 3. Replace {{clientId}} and {{clientSecret}} with values from ApiClientSeeder
# 4. Create test fixtures in ./tests/fixtures/ directory
# 5. Expected responses:
#    - 200: Success
#    - 201: Created
#    - 401: Unauthorized
#    - 403: Forbidden
#    - 404: Not Found
#    - 422: Validation Error
#    - 429: Too Many Requests
#    - 500: Server Error
